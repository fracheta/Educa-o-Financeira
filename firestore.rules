rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn() && request.auth.uid == userId && request.auth.token.email_verified == true;
    }

    function isOwnerRead(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrigin(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'isDefault', 'createdAt'])
        && data.keys().hasOnly(['userId', 'name', 'isDefault', 'createdAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.isDefault is bool
        && data.createdAt is timestamp;
    }

    function isValidCategory(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'type', 'color', 'isDefault', 'createdAt'])
        && data.keys().hasOnly(['userId', 'name', 'type', 'color', 'isDefault', 'createdAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.type is string && data.type in ['receita', 'despesa', 'ambos']
        && data.color is string && data.color.size() == 7 && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.isDefault is bool
        && data.createdAt is timestamp;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['userId', 'type', 'description', 'amount', 'date', 'category', 'origin', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'type', 'description', 'amount', 'date', 'category', 'origin', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.type is string && data.type in ['receita', 'despesa']
        && data.description is string && data.description.size() >= 2 && data.description.size() <= 120
        && (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 1000000000
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.origin is string && data.origin.size() >= 1 && data.origin.size() <= 60
        && data.status is string && data.status in ['Aberta', 'Aguardar', 'Paga']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwnerRead(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if false;

      match /origins/{originId} {
        allow get: if isValidId(userId) && isValidId(originId) && isOwnerRead(userId);
        allow list: if isValidId(userId) && isOwnerRead(userId);
        allow create: if isValidId(userId) && isValidId(originId)
          && isVerifiedOwner(userId)
          && isValidOrigin(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(originId)
          && isVerifiedOwner(userId)
          && isValidOrigin(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['name']);
        allow delete: if isValidId(userId) && isValidId(originId) && isVerifiedOwner(userId);
      }

      match /categories/{categoryId} {
        allow get: if isValidId(userId) && isValidId(categoryId) && isOwnerRead(userId);
        allow list: if isValidId(userId) && isOwnerRead(userId);
        allow create: if isValidId(userId) && isValidId(categoryId)
          && isVerifiedOwner(userId)
          && isValidCategory(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(categoryId)
          && isVerifiedOwner(userId)
          && isValidCategory(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'type', 'color']);
        allow delete: if isValidId(userId) && isValidId(categoryId) && isVerifiedOwner(userId);
      }

      match /transactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && isOwnerRead(userId);
        allow list: if isValidId(userId) && isOwnerRead(userId);
        allow create: if isValidId(userId) && isValidId(transactionId)
          && isVerifiedOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(transactionId)
          && isVerifiedOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['type', 'description', 'amount', 'date', 'category', 'origin', 'status', 'notes', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(transactionId) && isVerifiedOwner(userId);
      }
    }
  }
}
